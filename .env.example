# ==============================================================================
# AIUB Job Fair 2026 - Environment Variables Template
# Copy this file to .env for local development. NEVER commit real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domain & Routing
# ------------------------------------------------------------------------------
DOMAIN=jobfair.aiub.edu
ACME_EMAIL=admin@aiub.edu
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSql or SqlServer)
# ------------------------------------------------------------------------------
Database__Provider=PostgreSql
# For local Docker Compose:
ConnectionStrings__Default="Host=postgres;Port=5432;Database=aiub_jobfair;Username=postgres;Password=postgres"
# For Neon / Remote Postgres (example):
# ConnectionStrings__Default="Host=ep-xxx.neon.tech;Port=5432;Database=aiub_jobfair;Username=user;Password=pass;SslMode=Require"
# For SQL Server:
# Database__Provider=SqlServer
# ConnectionStrings__Default="Server=localhost;Database=aiub_jobfair;User Id=sa;Password=YourStrongPassword!;TrustServerCertificate=True"

POSTGRES_DB=aiub_jobfair
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_secret_change_me

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
Jwt__Secret=replace_with_a_random_min_64_character_hex_secret_string_here_now!
Jwt__Issuer=AIUB.JobFair
Jwt__Audience=AIUB.JobFair.Web
Jwt__AccessTokenExpirationMinutes=15
Jwt__RefreshTokenExpirationDays=7

# Initial Admin Seed Credentials (used only on first startup to seed admin)
ADMIN_INITIAL_EMAIL=jobfair.admin@aiub.edu
ADMIN_INITIAL_PASSWORD=ReplaceWithStrongAdminPassword123!

# ------------------------------------------------------------------------------
# 4. Storage (Cloudflare R2 / AWS S3 / S3-Compatible)
# ------------------------------------------------------------------------------
Storage__Provider=LocalDisk
# When switching to Cloudflare R2 / S3:
# Storage__Provider=S3
# Storage__ServiceUrl=https://<account-id>.r2.cloudflarestorage.com
# Storage__AccessKey=r2_access_key_id
# Storage__SecretKey=r2_secret_access_key
# Storage__BucketName=aiub-jobfair-assets
# Storage__PublicCustomDomain=https://assets.jobfair.aiub.edu

# ------------------------------------------------------------------------------
# 5. Email Sender (Generic SMTP - Brevo / Resend / AWS SES)
# ------------------------------------------------------------------------------
Email__SmtpHost=smtp-relay.brevo.com
Email__SmtpPort=587
Email__SmtpUsername=smtp_login_username
Email__SmtpPassword=smtp_login_password
Email__SenderEmail=jobfair@aiub.edu
Email__SenderName="AIUB Job Fair 2026"
Email__EnableSsl=true

# ------------------------------------------------------------------------------
# 6. Business Rules & Registration Restrictions
# ------------------------------------------------------------------------------
Student__AllowedEmailDomains=student.aiub.edu
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=https://jobfair.aiub.edu
